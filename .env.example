# Example environment configuration for SentinelGate
# Copy this to .env and customize

# Gateway configuration
TARGET_URL=http://127.0.0.1:5000
TRUST_PROXY=false

# Rate limiting
RATE_LIMIT=60
RATE_BURST=20
ALLOWLIST=127.0.0.1,localhost

# Database
DB_PATH=logs/siem.db

# Security
DASHBOARD_PASSWORD=change-me-before-exposing

# Allowed targets for scanner/simulator (comma-separated)
ALLOWED_TARGETS=

# Telegram alerts (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# External integrations (optional)
NVD_API_KEY=
ABUSEIPDB_KEY=

# Suricata integration (optional)
ENABLE_SURICATA=false
SURICATA_EVE_PATH=/var/log/suricata/eve.json

# Wazuh integration (optional)
ENABLE_WAZUH=false
WAZUH_URL=https://localhost:55000
WAZUH_USER=
WAZUH_PASSWORD=
